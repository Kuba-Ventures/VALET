# Environment
.env
.env.local

# Dependencies
node_modules/
.venv/
venv/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Data (user-specific, generated at runtime)
*.db
data/*.jsonl
data/active_session.json
data/.valet_output.txt
data/google_tokens.json
data/license_state.json
data/screenshots/

# Runtime logs — modified on every server restart, would otherwise trip
# self_mod.assert_clean_tree() on every other self-mod ship.
logs/
data/logs/
frontend/logs/
.valet/

# Google OAuth client secrets
google_credentials.json

# Certificates
*.pem

# Build
dist/
.vite/
frontend/.vite/

# IDE / System
.DS_Store
.vscode/
.idea/
.claude/*
# …but the supervised PR factory's reviewer agent must be tracked so CI (a clean
# runner with no access to ~/.claude) can load it. Keep this one file in the repo.
!.claude/agents/
.claude/agents/*
!.claude/agents/pr-reviewer.md
.arch/

# Desktop overlay
desktop-overlay/node_modules/
context/
*.db-shm
*.db-wal
.env
.env.*
build_id.txt

# Build artifacts (Rust target, PyInstaller, Tauri sidecar + generated) —
# never commit these; they're regenerated by packaging/build-macos.sh.
build/
dist/
src-tauri/target/
src-tauri/binaries/
src-tauri/gen/
*.dmg
