<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened-runtime exceptions PyInstaller binaries need to run signed -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Microphone access for the webview (Web Speech API / getUserMedia). The
       hardened runtime enforces this; without it a SIGNED build silently can't
       reach the mic and never appears in System Settings → Microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- Read + create events in Apple Calendar via EventKit (apple_calendar.py). -->
  <key>com.apple.security.personal-information.calendars</key>
  <true/>

  <!-- Drive other apps via AppleScript (the AppleScript control backend) -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>

  <!-- Reach the local backend (:8340) and the hosted proxy -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
