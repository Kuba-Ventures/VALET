# Required API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
FISH_API_KEY=your-fish-audio-api-key-here

# Optional: Fish Audio voice model (defaults to the VALET voice)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# Optional: Your name (VALET will address you by name)
# USER_NAME=Alex

# Wake-word name (casual). Frontend builds the trigger phrase as "ok <ASSISTANT_NAME>".
# Default is "vee" (VALET is the formal brand shown on the orb). Change this (and
# restart the backend) to rename the spoken wake word.
# ASSISTANT_NAME=vee

# Optional: Specific Apple Calendar accounts to read (comma-separated emails)
# If not set, VALET reads ALL calendars from Apple Calendar
# CALENDAR_ACCOUNTS=you@gmail.com,work@company.com
